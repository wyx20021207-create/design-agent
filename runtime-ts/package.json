{
  "name": "design-agent-runtime-ts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "smoke": "tsx test/smoke.ts",
    "typecheck": "tsc --noEmit",
    "cross": "tsx test/cross-boundary.ts",
    "conformance": "tsx test/conformance.ts",
    "staging": "tsx test/staging.ts",
    "isolation": "tsx test/isolation.ts",
    "cli": "tsx src/cli.ts",
    "serve": "tsx src/serve.ts",
    "ownership": "tsx test/ownership.ts",
    "async": "tsx test/async.ts",
    "async-crash": "tsx test/async-crash-start.ts && tsx test/async-crash-resume.ts",
    "recovery": "tsx test/recovery-start.ts && tsx test/recovery-resume.ts",
    "delivery": "tsx test/delivery.ts",
    "api": "tsx test/api.ts",
    "feishu": "tsx test/feishu.ts",
    "tools": "tsx test/tools.ts",
    "skills": "tsx test/skills-matrix.ts",
    "subagents": "tsx test/subagents.ts",
    "prune": "node scripts/prune-sandboxes.mjs",
    "prune:volumes": "node scripts/prune-sandboxes.mjs --volumes",
    "prune:dry": "node scripts/prune-sandboxes.mjs --dry-run --volumes"
  },
  "dependencies": {
    "@earendil-works/chord": "^1.5.0",
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-durable": "^1.5.0",
    "@earendil-works/pi-schema": "^1.5.0",
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "fastify": "^5.12.8",
    "smol-toml": "^1.9.1",
    "tar-stream": "^3.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/tar-stream": "^3.1.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
